class CuentaCorreo:
    """Clase que representa las credenciales de una cuenta de correo electrónico."""

    def __init__(self, usuario: str, password: str):
        # Atributos de instancia
        self.usuario = usuario
        self.password = password

    def mostrar_info(self) -> None:
        """Muestra la información y el estado actual de la cuenta."""
        print(f"📧 Usuario : {self.usuario}")
        print(f"🔑 Password: {'*' * len(self.password)}")  # Enmascara la contraseña por seguridad


